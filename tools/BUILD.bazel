load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//tools:autotools.bzl", "configure_make", "configure_static_library")
load("//tools:cmake.bzl", "legacy_cmake")

# Shared Starlark tooling lives here; runtime scripts live in subpackages.

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.bzl"]) + ["BUILD.bazel"],
    visibility = ["//tools/audit:__pkg__"],
)

filegroup(
    name = "autotools_smoke_tree",
    srcs = glob(["testdata/autotools_project/**"]),
)

configure_make(
    name = "autotools_smoke_build",
    srcs = [":autotools_smoke_tree"],
    configure = "testdata/autotools_project/configure",
    out_binaries = ["hello"],
)

sh_test(
    name = "autotools_smoke_test",
    size = "small",
    srcs = ["testdata/run_autotools_smoke.sh"],
    data = [":autotools_smoke_build_hello"],
    env = {"HELLO_BIN": "$(rootpath :autotools_smoke_build_hello)"},
)

# Regression target for tools/cmake.bzl (ADR 0010/0021): a minimal CMake
# project built with the pinned cmake, promoted from the fleet-ninja port.
filegroup(
    name = "cmake_smoke_tree",
    srcs = glob(["testdata/cmake_project/**"]),
)

legacy_cmake(
    name = "cmake_smoke_build",
    srcs = [":cmake_smoke_tree"],
    cmakelists = "testdata/cmake_project/CMakeLists.txt",
    out_binaries = ["hello"],
)

sh_test(
    name = "cmake_smoke_test",
    size = "small",
    srcs = ["testdata/run_cmake_smoke.sh"],
    data = [":cmake_smoke_build_hello"],
    env = {"HELLO_BIN": "$(rootpath :cmake_smoke_build_hello)"},
)

filegroup(
    name = "autotools_static_lib_tree",
    srcs = glob(["testdata/autotools_static_lib/**"]),
)

configure_static_library(
    name = "autotools_static_lib",
    srcs = [":autotools_static_lib_tree"],
    configure = "testdata/autotools_static_lib/configure",
    hdrs = ["include/autotools_static_lib.h"],
    static_library = "lib/libautotools_static_lib.a",
)

cc_binary(
    name = "autotools_static_lib_user",
    srcs = ["testdata/autotools_static_lib_user.c"],
    deps = [":autotools_static_lib"],
)

sh_test(
    name = "autotools_static_lib_test",
    size = "small",
    srcs = ["testdata/run_autotools_static_lib.sh"],
    data = [":autotools_static_lib_user"],
    env = {"BIN": "$(rootpath :autotools_static_lib_user)"},
)
