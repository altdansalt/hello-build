# The seven-target interface, built from a *standalone* workspace using only
# @hello_build//tools/... — the consumability regression target for ADR 0019.
# Mirrors examples/hello in the monorepo; if the two drift, the monorepo one
# is the spec.

load("@hello_build//tools:inventory.bzl", "upstream_inventory_test")
load("@hello_build//tools:make.bzl", "legacy_make")
load("@hello_build//tools:parity.bzl", "parity_test")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

legacy_make(
    name = "legacy_build",
    srcs = glob(["upstream/**"]),
    makefile = "upstream/Makefile",
    out_binaries = ["hello"],
)

alias(
    name = "legacy_binary",
    actual = ":legacy_build_hello",
)

sh_test(
    name = "legacy_test",
    size = "small",
    srcs = ["upstream/tests/run_tests.sh"],
    data = [":legacy_binary"],
    env = {"HELLO_BIN": "$(rootpath :legacy_binary)"},
)

cc_binary(
    name = "bazel_binary",
    srcs = ["upstream/src/hello.c"],
    copts = [
        "-O2",
        "-Wall",
    ],
)

alias(
    name = "bazel_build",
    actual = ":bazel_binary",
)

sh_test(
    name = "bazel_test",
    size = "small",
    srcs = ["upstream/tests/run_tests.sh"],
    data = [":bazel_binary"],
    env = {"HELLO_BIN": "$(rootpath :bazel_binary)"},
)

parity_test(
    name = "parity_test",
    size = "small",
    bazel_binary = ":bazel_binary",
    cases = "parity_cases.txt",
    legacy_binary = ":legacy_binary",
    suite = "upstream/tests/run_tests.sh",
    suite_bin_env = "HELLO_BIN",
)

filegroup(
    name = "upstream_test_files",
    srcs = glob(["upstream/tests/**"]),
)

upstream_inventory_test(
    name = "upstream_inventory_test",
    patterns = ["upstream/tests/*.sh"],
    repo_hint = "_main",
    tree = ":upstream_test_files",
    wired = ["upstream/tests/run_tests.sh"],
)
