"""hello-build: tools and examples for adding Bazel build+test targets to non-Bazel repos.

Fetching happens only in Bazel's fetch phase, pinned by MODULE.bazel.lock and
per-archive sha256s; build and test actions themselves run without network
access (see docs/decisions/0006-hermetic-actions-pinned-fetches.md).
"""

module(
    name = "hello_build",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "2.0.2")
bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.88.0"],
)
use_repo(
    rust,
    "rust_linux_x86_64__x86_64-unknown-linux-gnu__stable_tools",
    "rust_toolchains",
)
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
