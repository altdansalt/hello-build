# the main-repo runfiles dir). The name is this repo's canonical bzlmod name
# (use_repo_rule http_archive in the root module) — stable for the pinned
# Bazel version.
RMUX_RUNFILES_MANIFEST_DIR = "../+http_archive+rmux_src"

