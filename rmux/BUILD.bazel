# Public interface targets live here; rmux.BUILD.bazel is injected into
# @rmux_src for the Bazel-native source build and Bazel-compiled upstream tests.

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:cargo.bzl", "legacy_cargo", "legacy_cargo_test")
load("//tools:compilation_mode.bzl", "opt_binary")
load("//tools:inventory.bzl", "upstream_inventory_test")
load("//tools:parity.bzl", "parity_test")
load(":tests.bzl", "RMUX_FLAKY_SKIPS", "RMUX_INTEGRATION_TESTS", "RMUX_LIB_TESTS")
load(":vendor_crates.bzl", "RMUX_VENDOR_CRATES")

legacy_cargo(
    name = "legacy_build",
    srcs = ["@rmux_src//:tree"],
    cargo_toml = "@rmux_src//:Cargo.toml",
    cargo_lock = "@rmux_src//:Cargo.lock",
    vendor_crates = RMUX_VENDOR_CRATES,
    cargo_args = [
        "build",
        "--locked",
        "--offline",
        "--no-default-features",
        "--release",
        "--bin",
        "rmux",
    ],
    out_binaries = ["target/release/rmux"],
)

alias(
    name = "legacy_binary",
    actual = ":legacy_build_rmux",
)

# The shipped legacy binary is `cargo build --release`; the Bazel-native
# binary must match that profile (debug_assertions and overflow checks are
# behavior, not just optimization — ADR 0008), so it is pinned to -c opt
# regardless of the compilation mode `bazel test //...` runs under.
opt_binary(
    name = "bazel_binary",
    binary = "@rmux_src//:rmux",
)

alias(
    name = "bazel_build",
    actual = ":bazel_binary",
)

# The unmodified upstream suite (`cargo test` on the root package: 573 tests),
# compiled and run offline by the pinned Bazel cargo/rustc in dev profile,
# exactly as upstream runs it.
legacy_cargo_test(
    name = "legacy_test",
    size = "large",
    timeout = "eternal",
    srcs = ["@rmux_src//:tree"],
    cargo_toml = "@rmux_src//:Cargo.toml",
    cargo_lock = "@rmux_src//:Cargo.lock",
    vendor_crates = RMUX_VENDOR_CRATES,
    cargo_args = [
        "test",
        "--locked",
        "--offline",
        "--no-default-features",
        "--workspace",
    ],
    skip_tests = RMUX_FLAKY_SKIPS,
)

# The same upstream tests, Bazel-compiled against the Bazel-native build
# (fastbuild = cargo's dev profile; see rmux.BUILD.bazel).
test_suite(
    name = "bazel_test",
    tests = ["@rmux_src//:rmux_unit_test"] + [
        "@rmux_src//:%s_unit_test" % lib
        for lib in RMUX_LIB_TESTS
    ] + [
        "@rmux_src//:it_%s" % t
        for t in RMUX_INTEGRATION_TESTS
    ],
)

# Daemon-free functional smoke tier, shared with parity below.
sh_test(
    name = "legacy_test_functional",
    size = "small",
    srcs = ["tests/smoke.sh"],
    data = [":legacy_binary"],
    env = {"RMUX_BIN": "$(rootpath :legacy_binary)"},
)

sh_test(
    name = "bazel_test_functional",
    size = "small",
    srcs = ["tests/smoke.sh"],
    data = [":bazel_binary"],
    env = {"RMUX_BIN": "$(rootpath :bazel_binary)"},
)

parity_test(
    name = "parity_test",
    size = "small",
    bazel_binary = ":bazel_binary",
    cases = "parity_cases.txt",
    legacy_binary = ":legacy_binary",
    suite = "tests/smoke.sh",
    suite_bin_env = "RMUX_BIN",
)

parity_test(
    name = "parity_test_jsonl",
    size = "small",
    bazel_binary = ":bazel_binary",
    cases_jsonl = "parity_cases.jsonl",
    legacy_binary = ":legacy_binary",
)

# Every upstream tests/*.rs is wired into :bazel_test (and :legacy_test runs
# the whole workspace via cargo); reconciled against the fetched tree so a
# version bump's new tests surface as red (ADR 0015).
upstream_inventory_test(
    name = "upstream_inventory_test",
    patterns = ["tests/*.rs"],
    repo_hint = "rmux_src",
    tree = "@rmux_src//:tree",
    wired = ["tests/%s.rs" % t for t in RMUX_INTEGRATION_TESTS],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["**"]),
    visibility = ["//tools/audit:__pkg__"],
)
