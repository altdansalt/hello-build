# Redis 7.2.7 (see UPSTREAM) under the seven-target interface (ADR 0001).
# Primary binary: redis-server; redis-cli is the secondary (suffixed targets).
# See redis/README.md for what each target covers and the parity story.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:make.bzl", "legacy_make")
load("//tools:parity.bzl", "parity_test")
load(":srcs.bzl", "REDIS_CLI_SRCS", "REDIS_SERVER_SRCS")

# -----------------------------------------------------------------------------
# Legacy build: unmodified upstream `make MALLOC=libc`.
#
# MALLOC=libc is an upstream-documented option (upstream/README.md "Allocator");
# we use it on both sides so the legacy and Bazel builds use the same allocator
# instead of teaching Bazel to run jemalloc's configure. SOURCE_DATE_EPOCH=0 is
# upstream's own reproducible-build knob (src/mkreleasehdr.sh); pinning it on
# both sides makes version metadata — and thus `--version` output —
# byte-identical with no normalization.
# -----------------------------------------------------------------------------

legacy_make(
    name = "legacy_build",
    srcs = glob(["upstream/**"]),
    env = {"SOURCE_DATE_EPOCH": "0"},
    make_args = ["MALLOC=libc"],
    make_dir = "upstream",
    out_binaries = [
        "src/redis-server",
        "src/redis-cli",
        "src/redis-benchmark",
    ],
)

alias(
    name = "legacy_binary",
    actual = ":legacy_build_redis-server",
)

alias(
    name = "legacy_binary_cli",
    actual = ":legacy_build_redis-cli",
)

# -----------------------------------------------------------------------------
# Bazel-native build. Sources, compiler flags, defines, and link flags are
# transcribed from `make V=1 MALLOC=libc` output (see srcs.bzl and README.md);
# divergence here is the #1 source of parity failures.
# -----------------------------------------------------------------------------

# Flags shared by every translation unit of redis-server and redis-cli.
REDIS_COPTS = [
    "-pedantic",
    "-DREDIS_STATIC=",
    "-std=gnu11",
    "-Wall",
    "-W",
    "-Wno-missing-field-initializers",
    "-Werror=deprecated-declarations",
    "-Wstrict-prototypes",
    "-O3",
    "-g",
    "-ggdb",
    "-flto=auto",
]

# Upstream link line: cc -O3 -flto -g -ggdb -rdynamic ... -lm -ldl -pthread -lrt
REDIS_LINKOPTS = [
    "-O3",
    "-flto",
    "-g",
    "-ggdb",
    "-rdynamic",
    "-lm",
    "-ldl",
    "-pthread",
    "-lrt",
]

# release.h is generated by the upstream script; SOURCE_DATE_EPOCH=0 makes it
# (and hence --version output) identical to the legacy build's, byte for byte.
genrule(
    name = "release_h",
    srcs = ["upstream/src/mkreleasehdr.sh"],
    outs = ["generated/release.h"],
    cmd = """\
script="$$PWD/$(execpath upstream/src/mkreleasehdr.sh)"
out="$$PWD/$@"
workdir=$$(mktemp -d)
cd "$$workdir"
SOURCE_DATE_EPOCH=0 sh "$$script" > /dev/null
cp release.h "$$out"
""",
)

cc_library(
    name = "release_header",
    hdrs = ["generated/release.h"],
    strip_include_prefix = "generated",
)

# Private headers and textually-included files (ae backends, commands.def).
cc_library(
    name = "server_headers",
    hdrs = glob(["upstream/src/*.h"]),
    includes = ["upstream/src"],
    textual_hdrs = glob([
        "upstream/src/*.def",
        "upstream/src/ae_*.c",
    ]),
)

cc_library(
    name = "hiredis",
    srcs = [
        "upstream/deps/hiredis/alloc.c",
        "upstream/deps/hiredis/async.c",
        "upstream/deps/hiredis/hiredis.c",
        "upstream/deps/hiredis/net.c",
        "upstream/deps/hiredis/read.c",
        "upstream/deps/hiredis/sds.c",
        "upstream/deps/hiredis/sockcompat.c",
    ],
    hdrs = glob(["upstream/deps/hiredis/*.h"]),
    # async.c does `#include "dict.c"`.
    textual_hdrs = ["upstream/deps/hiredis/dict.c"],
    copts = [
        "-std=c99",
        "-O3",
        "-fPIC",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wstrict-prototypes",
        "-Wwrite-strings",
        "-Wno-missing-field-initializers",
        "-g",
        "-ggdb",
        "-pedantic",
    ],
    includes = ["upstream/deps/hiredis"],
)

# Headers-only: upstream compiles everything with -I../deps/lua/src but links
# liblua.a only into redis-server; redis-cli must not link lua.
cc_library(
    name = "lua_headers",
    hdrs = glob(["upstream/deps/lua/src/*.h"]),
    includes = ["upstream/deps/lua/src"],
)

cc_library(
    name = "lua",
    srcs = glob(
        ["upstream/deps/lua/src/*.c"],
        exclude = [
            "upstream/deps/lua/src/lua.c",  # standalone interpreter main()
            "upstream/deps/lua/src/luac.c",  # compiler main()
            "upstream/deps/lua/src/print.c",  # part of luac
        ],
    ),
    hdrs = glob(["upstream/deps/lua/src/*.h"]),
    copts = [
        "-Wall",
        "-DLUA_ANSI",
        "-DENABLE_CJSON_GLOBAL",
        "-DREDIS_STATIC=",
        "-DLUA_USE_MKSTEMP",
        "-O2",
    ],
    includes = ["upstream/deps/lua/src"],
    # lua_cjson.c reaches into ../../../src/solarisfixes.h.
    deps = [":server_headers"],
)

cc_library(
    name = "hdr_histogram",
    srcs = ["upstream/deps/hdr_histogram/hdr_histogram.c"],
    hdrs = glob(["upstream/deps/hdr_histogram/*.h"]),
    copts = [
        "-std=c99",
        "-Wall",
        "-Os",
        "-g",
        "-DHDR_MALLOC_INCLUDE=\\\"hdr_redis_malloc.h\\\"",
    ],
    includes = ["upstream/deps/hdr_histogram"],
)

cc_library(
    name = "fpconv",
    srcs = ["upstream/deps/fpconv/fpconv_dtoa.c"],
    hdrs = glob(["upstream/deps/fpconv/*.h"]),
    copts = [
        "-Wall",
        "-Os",
        "-g",
    ],
    includes = ["upstream/deps/fpconv"],
)

cc_library(
    name = "linenoise",
    srcs = ["upstream/deps/linenoise/linenoise.c"],
    hdrs = ["upstream/deps/linenoise/linenoise.h"],
    copts = [
        "-Wall",
        "-Os",
        "-g",
    ],
    includes = ["upstream/deps/linenoise"],
)

cc_binary(
    name = "redis-server",
    srcs = REDIS_SERVER_SRCS,
    copts = REDIS_COPTS,
    linkopts = REDIS_LINKOPTS,
    deps = [
        ":fpconv",
        ":hdr_histogram",
        ":hiredis",
        ":lua",
        ":release_header",
        ":server_headers",
    ],
)

cc_binary(
    name = "redis-cli",
    srcs = REDIS_CLI_SRCS,
    copts = REDIS_COPTS,
    linkopts = REDIS_LINKOPTS,
    deps = [
        ":hiredis",
        ":linenoise",
        ":lua_headers",
        ":release_header",
        ":server_headers",
    ],
)

alias(
    name = "bazel_build",
    actual = ":bazel_binaries",
)

filegroup(
    name = "bazel_binaries",
    srcs = [
        ":redis-cli",
        ":redis-server",
    ],
)

alias(
    name = "bazel_binary",
    actual = ":redis-server",
)

alias(
    name = "bazel_binary_cli",
    actual = ":redis-cli",
)

# -----------------------------------------------------------------------------
# Tests. Two suites:
#  - upstream tcl suite (the real thing; needs tclsh on the host, hence the
#    requires-tclsh tag): legacy_test / bazel_test
#  - portable functional suite (POSIX sh + redis-cli only):
#    legacy_test_functional / bazel_test_functional, also reused by
#    parity_test in suite mode
# -----------------------------------------------------------------------------

# Units chosen to exercise the core engine, every collection type, expiry,
# and the embedded lua scripting; ~30s wall clock. The full suite also has
# integration/* (replication, cluster) — future work, see README.
TCL_UNITS = " ".join([
    "unit/type/string",
    "unit/type/incr",
    "unit/type/list",
    "unit/type/hash",
    "unit/type/set",
    "unit/type/zset",
    "unit/expire",
    "unit/keyspace",
    "unit/auth",
    "unit/scripting",
])

filegroup(
    name = "upstream_tree",
    srcs = glob(["upstream/**"]),
)

sh_test(
    name = "legacy_test",
    size = "medium",
    srcs = ["tests/run_tcl_suite.sh"],
    data = [
        ":legacy_binary",
        ":legacy_binary_cli",
        ":legacy_build_redis-benchmark",
        ":upstream_tree",
        "upstream/runtest",
    ],
    env = {
        "REDIS_SERVER": "$(rootpath :legacy_binary)",
        "UPSTREAM_RUNTEST": "$(rootpath upstream/runtest)",
        "TCL_UNITS": TCL_UNITS,
        "TCL_PORT_BASE": "21111",
    },
    # exclusive: the suite's port allocator probes host TCP ports; concurrent
    # tcl suite runs race each other.
    tags = [
        "exclusive",
        "requires-tclsh",
    ],
)

sh_test(
    name = "bazel_test",
    size = "medium",
    srcs = ["tests/run_tcl_suite.sh"],
    data = [
        ":redis-cli",
        ":redis-server",
        ":upstream_tree",
        "upstream/runtest",
    ],
    env = {
        "REDIS_SERVER": "$(rootpath :redis-server)",
        "UPSTREAM_RUNTEST": "$(rootpath upstream/runtest)",
        "TCL_UNITS": TCL_UNITS,
        "TCL_PORT_BASE": "24111",
    },
    tags = [
        "exclusive",
        "requires-tclsh",
    ],
)

sh_test(
    name = "legacy_test_functional",
    size = "medium",
    srcs = ["tests/functional.sh"],
    data = [
        ":legacy_binary",
        ":legacy_binary_cli",
    ],
    env = {"REDIS_SERVER": "$(rootpath :legacy_binary)"},
)

sh_test(
    name = "bazel_test_functional",
    size = "medium",
    srcs = ["tests/functional.sh"],
    data = [
        ":redis-cli",
        ":redis-server",
    ],
    env = {"REDIS_SERVER": "$(rootpath :redis-server)"},
)

# -----------------------------------------------------------------------------
# Parity: the functional suite must produce byte-identical output on both
# builds (and pass), and curated invocations must match exactly. No output
# normalization is needed — SOURCE_DATE_EPOCH pins the build id on both
# sides (see the legacy_build comment).
# -----------------------------------------------------------------------------

parity_test(
    name = "parity_test",
    size = "medium",
    bazel_binary = ":redis-server",
    cases = "parity_cases_server.txt",
    data = [
        ":legacy_binary_cli",
        ":redis-cli",
    ],
    legacy_binary = ":legacy_binary",
    suite = "tests/functional.sh",
    suite_bin_env = "REDIS_SERVER",
)

parity_test(
    name = "parity_test_cli",
    size = "small",
    bazel_binary = ":redis-cli",
    cases = "parity_cases_cli.txt",
    legacy_binary = ":legacy_binary_cli",
)
