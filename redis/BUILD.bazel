# Redis 7.2.7 under the seven-target interface (ADR 0001). The source tree is
# fetched as @redis_src (MODULE.bazel, pinned by sha256; see UPSTREAM); the
# Bazel-native cc build lives in redis.BUILD.bazel, injected into that repo.
# Primary binary: redis-server; redis-cli is the secondary (suffixed targets).
# See redis/README.md for what each target covers and the parity story.

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:inventory.bzl", "upstream_inventory_test")
load("//tools:make.bzl", "legacy_make")
load("//tools:parity.bzl", "parity_test")

# -----------------------------------------------------------------------------
# Legacy build: unmodified upstream `make MALLOC=libc`.
#
# MALLOC=libc is an upstream-documented option (README.md "Allocator" in
# @redis_src); we use it on both sides so the legacy and Bazel builds use the
# same allocator instead of teaching Bazel to run jemalloc's configure.
# SOURCE_DATE_EPOCH=0 is upstream's own reproducible-build knob
# (src/mkreleasehdr.sh); pinning it on both sides makes version metadata —
# and thus `--version` output — byte-identical with no normalization.
# -----------------------------------------------------------------------------

legacy_make(
    name = "legacy_build",
    srcs = ["@redis_src//:tree"],
    env = {"SOURCE_DATE_EPOCH": "0"},
    make_args = ["MALLOC=libc"],
    makefile = "@redis_src//:Makefile",
    out_binaries = [
        "src/redis-server",
        "src/redis-cli",
        "src/redis-benchmark",
    ],
)

alias(
    name = "legacy_binary",
    actual = ":legacy_build_redis-server",
)

alias(
    name = "legacy_binary_cli",
    actual = ":legacy_build_redis-cli",
)

# --- Bazel-native build: defined in redis.BUILD.bazel inside @redis_src ---

alias(
    name = "bazel_build",
    actual = ":bazel_binaries",
)

filegroup(
    name = "bazel_binaries",
    srcs = [
        "@redis_src//:redis-cli",
        "@redis_src//:redis-server",
    ],
)

alias(
    name = "bazel_binary",
    actual = "@redis_src//:redis-server",
)

alias(
    name = "bazel_binary_cli",
    actual = "@redis_src//:redis-cli",
)

# -----------------------------------------------------------------------------
# Tests. Two suites (ADR 0005):
#  - upstream tcl suite (the real thing; needs tclsh on the host, hence the
#    requires-tclsh tag): legacy_test / bazel_test
#  - portable functional suite (POSIX sh + redis-cli only):
#    legacy_test_functional / bazel_test_functional, also reused by
#    parity_test in suite mode
# -----------------------------------------------------------------------------

# Units chosen to exercise the core engine, every collection type, expiry,
# and the embedded lua scripting; ~15s wall clock. The full suite also has
# integration/* (replication, cluster) — future work, see README.
TCL_UNIT_LIST = [
    "unit/type/string",
    "unit/type/incr",
    "unit/type/list",
    "unit/type/hash",
    "unit/type/set",
    "unit/type/zset",
    "unit/expire",
    "unit/keyspace",
    "unit/auth",
    "unit/scripting",
]

TCL_UNITS = " ".join(TCL_UNIT_LIST)

sh_test(
    name = "legacy_test",
    size = "medium",
    srcs = ["tests/run_tcl_suite.sh"],
    data = [
        ":legacy_binary",
        ":legacy_binary_cli",
        ":legacy_build_redis-benchmark",
        "@redis_src//:runtest",
        "@redis_src//:tree",
    ],
    env = {
        "REDIS_SERVER": "$(rootpath :legacy_binary)",
        "UPSTREAM_RUNTEST": "$(rootpath @redis_src//:runtest)",
        "TCL_UNITS": TCL_UNITS,
        "TCL_PORT_BASE": "21111",
    },
    tags = ["requires-tclsh"],
)

sh_test(
    name = "bazel_test",
    size = "medium",
    srcs = ["tests/run_tcl_suite.sh"],
    data = [
        "@redis_src//:redis-cli",
        "@redis_src//:redis-server",
        "@redis_src//:runtest",
        "@redis_src//:tree",
    ],
    env = {
        "REDIS_SERVER": "$(rootpath @redis_src//:redis-server)",
        "UPSTREAM_RUNTEST": "$(rootpath @redis_src//:runtest)",
        "TCL_UNITS": TCL_UNITS,
        "TCL_PORT_BASE": "24111",
    },
    tags = ["requires-tclsh"],
)

sh_test(
    name = "legacy_test_functional",
    size = "medium",
    srcs = ["tests/functional.sh"],
    data = [
        ":legacy_binary",
        ":legacy_binary_cli",
    ],
    env = {"REDIS_SERVER": "$(rootpath :legacy_binary)"},
)

sh_test(
    name = "bazel_test_functional",
    size = "medium",
    srcs = ["tests/functional.sh"],
    data = [
        "@redis_src//:redis-cli",
        "@redis_src//:redis-server",
    ],
    env = {"REDIS_SERVER": "$(rootpath @redis_src//:redis-server)"},
)

# -----------------------------------------------------------------------------
# Parity: the functional suite must produce byte-identical output on both
# builds (and pass), and curated invocations must match exactly. No output
# normalization is needed — SOURCE_DATE_EPOCH pins the build id on both
# sides (see the legacy_build comment).
# -----------------------------------------------------------------------------

parity_test(
    name = "parity_test",
    size = "medium",
    bazel_binary = "@redis_src//:redis-server",
    cases = "parity_cases_server.txt",
    data = [
        ":legacy_binary_cli",
        "@redis_src//:redis-cli",
    ],
    legacy_binary = ":legacy_binary",
    suite = "tests/functional.sh",
    suite_bin_env = "REDIS_SERVER",
)

parity_test(
    name = "parity_test_cli",
    size = "small",
    bazel_binary = "@redis_src//:redis-cli",
    cases = "parity_cases_cli.txt",
    legacy_binary = ":legacy_binary_cli",
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["**"]),
    visibility = ["//tools/audit:__pkg__"],
)

# Every upstream tcl unit/integration file is either in TCL_UNIT_LIST or
# excluded with a reason — reconciled against the fetched tree (ADR 0015).
upstream_inventory_test(
    name = "upstream_inventory_test",
    exclusions_file = "upstream_inventory_exclusions.txt",
    patterns = [
        "tests/integration/**/*.tcl",
        "tests/unit/**/*.tcl",
    ],
    repo_hint = "redis_src",
    tree = "@redis_src//:tree",
    wired = ["tests/%s.tcl" % u for u in TCL_UNIT_LIST],
)
