# Injected into @redis_src (the pristine redis 7.2.7 release tarball; see
# redis/UPSTREAM and MODULE.bazel). Defines the Bazel-native build of
# redis-server and redis-cli plus the filegroups the legacy build and the
# upstream test suite need. The seven-target interface lives in
# @hello_build//redis:BUILD.bazel and aliases into here.
#
# Sources, compiler flags, defines, and link flags are transcribed from
# `make V=1 MALLOC=libc` output (see srcs.bzl and redis/README.md);
# divergence here is the #1 source of parity failures.

load("@hello_build//redis:srcs.bzl", "REDIS_CLI_SRCS", "REDIS_SERVER_SRCS")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The whole release tree, for the legacy build and the upstream tcl suite.
filegroup(
    name = "tree",
    srcs = glob(["**"]),
)

exports_files([
    "Makefile",
    "runtest",
])

# Flags shared by every translation unit of redis-server and redis-cli.
REDIS_COPTS = [
    "-pedantic",
    "-DREDIS_STATIC=",
    "-std=gnu11",
    "-Wall",
    "-W",
    "-Wno-missing-field-initializers",
    "-Werror=deprecated-declarations",
    "-Wstrict-prototypes",
    "-O3",
    "-g",
    "-ggdb",
    "-flto=auto",
]

# Upstream link line: cc -O3 -flto -g -ggdb -rdynamic ... -lm -ldl -pthread -lrt
REDIS_LINKOPTS = [
    "-O3",
    "-flto",
    "-g",
    "-ggdb",
    "-rdynamic",
    "-lm",
    "-ldl",
    "-pthread",
    "-lrt",
]

# release.h is generated by the upstream script; SOURCE_DATE_EPOCH=0 makes it
# (and hence --version output) identical to the legacy build's, byte for byte.
genrule(
    name = "release_h",
    srcs = ["src/mkreleasehdr.sh"],
    outs = ["generated/release.h"],
    cmd = """\
script="$$PWD/$(execpath src/mkreleasehdr.sh)"
out="$$PWD/$@"
workdir=$$(mktemp -d)
cd "$$workdir"
SOURCE_DATE_EPOCH=0 sh "$$script" > /dev/null
cp release.h "$$out"
""",
)

cc_library(
    name = "release_header",
    hdrs = ["generated/release.h"],
    strip_include_prefix = "generated",
)

# Private headers and textually-included files (ae backends, commands.def).
cc_library(
    name = "server_headers",
    hdrs = glob(["src/*.h"]),
    includes = ["src"],
    textual_hdrs = glob([
        "src/*.def",
        "src/ae_*.c",
    ]),
)

cc_library(
    name = "hiredis",
    srcs = [
        "deps/hiredis/alloc.c",
        "deps/hiredis/async.c",
        "deps/hiredis/hiredis.c",
        "deps/hiredis/net.c",
        "deps/hiredis/read.c",
        "deps/hiredis/sds.c",
        "deps/hiredis/sockcompat.c",
    ],
    hdrs = glob(["deps/hiredis/*.h"]),
    # async.c does `#include "dict.c"`.
    textual_hdrs = ["deps/hiredis/dict.c"],
    copts = [
        "-std=c99",
        "-O3",
        "-fPIC",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wstrict-prototypes",
        "-Wwrite-strings",
        "-Wno-missing-field-initializers",
        "-g",
        "-ggdb",
        "-pedantic",
    ],
    includes = ["deps/hiredis"],
)

# Headers-only: upstream compiles everything with -I../deps/lua/src but links
# liblua.a only into redis-server; redis-cli must not link lua.
cc_library(
    name = "lua_headers",
    hdrs = glob(["deps/lua/src/*.h"]),
    includes = ["deps/lua/src"],
)

cc_library(
    name = "lua",
    srcs = glob(
        ["deps/lua/src/*.c"],
        exclude = [
            "deps/lua/src/lua.c",  # standalone interpreter main()
            "deps/lua/src/luac.c",  # compiler main()
            "deps/lua/src/print.c",  # part of luac
        ],
    ),
    hdrs = glob(["deps/lua/src/*.h"]),
    copts = [
        "-Wall",
        "-DLUA_ANSI",
        "-DENABLE_CJSON_GLOBAL",
        "-DREDIS_STATIC=",
        "-DLUA_USE_MKSTEMP",
        "-O2",
    ],
    includes = ["deps/lua/src"],
    # lua_cjson.c reaches into ../../../src/solarisfixes.h.
    deps = [":server_headers"],
)

cc_library(
    name = "hdr_histogram",
    srcs = ["deps/hdr_histogram/hdr_histogram.c"],
    hdrs = glob(["deps/hdr_histogram/*.h"]),
    copts = [
        "-std=c99",
        "-Wall",
        "-Os",
        "-g",
        "-DHDR_MALLOC_INCLUDE=\\\"hdr_redis_malloc.h\\\"",
    ],
    includes = ["deps/hdr_histogram"],
)

cc_library(
    name = "fpconv",
    srcs = ["deps/fpconv/fpconv_dtoa.c"],
    hdrs = glob(["deps/fpconv/*.h"]),
    copts = [
        "-Wall",
        "-Os",
        "-g",
    ],
    includes = ["deps/fpconv"],
)

cc_library(
    name = "linenoise",
    srcs = ["deps/linenoise/linenoise.c"],
    hdrs = ["deps/linenoise/linenoise.h"],
    copts = [
        "-Wall",
        "-Os",
        "-g",
    ],
    includes = ["deps/linenoise"],
)

cc_binary(
    name = "redis-server",
    srcs = REDIS_SERVER_SRCS + glob(["src/*.h"]),
    copts = REDIS_COPTS,
    linkopts = REDIS_LINKOPTS,
    deps = [
        ":fpconv",
        ":hdr_histogram",
        ":hiredis",
        ":lua",
        ":release_header",
        ":server_headers",
    ],
)

cc_binary(
    name = "redis-cli",
    srcs = REDIS_CLI_SRCS + glob(["src/*.h"]),
    copts = REDIS_COPTS,
    linkopts = REDIS_LINKOPTS,
    deps = [
        ":hiredis",
        ":linenoise",
        ":lua_headers",
        ":release_header",
        ":server_headers",
    ],
)
